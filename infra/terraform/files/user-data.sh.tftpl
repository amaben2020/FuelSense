#!/bin/bash
# First boot of a FuelSense backend box. Rebuilds what the hand-built box has:
# Node 18, Caddy, a pg16 client at /opt/pg16 for the nightly dump, a 2 GB swap
# file, and the systemd units from backend/ops/. Runs once. The code arrives
# with the first deploy-backend.yml run, which also starts the app.
set -euxo pipefail

dnf install -y nodejs nodejs-npm rsync git postgresql16

# The box has 1 GB of RAM; npm install alone can exceed it.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# db-backup.sh runs $PG_BIN/pg_dump with PG_BIN=/opt/pg16. The hand-built box
# has extracted binaries there; here the package provides them.
mkdir -p /opt/pg16
for b in pg_dump pg_restore psql; do ln -sf "/usr/bin/$b" "/opt/pg16/$b"; done

curl -fsSL "https://caddyserver.com/api/download?os=linux&arch=amd64" -o /usr/local/bin/caddy
chmod +x /usr/local/bin/caddy
mkdir -p /etc/caddy
cat > /etc/caddy/Caddyfile <<'CADDY'
${api_domain} {
    reverse_proxy localhost:5001
}
%{ if apex_redirect_domain != null ~}

${apex_redirect_domain} {
    redir https://www.${apex_redirect_domain}{uri} permanent
}
%{ endif ~}
CADDY

cat > /etc/systemd/system/caddy.service <<'UNIT'
${caddy_unit}
UNIT
cat > /etc/systemd/system/fuelsense.service <<'UNIT'
${fuelsense_unit}
UNIT
cat > /etc/systemd/system/fuelsense-db-backup.service <<'UNIT'
${backup_service}
UNIT
cat > /etc/systemd/system/fuelsense-db-backup.timer <<'UNIT'
${backup_timer}
UNIT

mkdir -p /home/ec2-user/backend
# The app's .env comes from SSM, put there once by hand (see infra/README.md).
# If it is not there yet the box still finishes; copy it over before starting.
if aws ssm get-parameter --region ${region} --name '${env_parameter}' --with-decryption \
     --query Parameter.Value --output text > /home/ec2-user/backend/.env.tmp; then
  mv /home/ec2-user/backend/.env.tmp /home/ec2-user/backend/.env
  chmod 600 /home/ec2-user/backend/.env
else
  rm -f /home/ec2-user/backend/.env.tmp
  echo "WARNING: ${env_parameter} not found; put backend/.env in place before the first deploy"
fi
chown -R ec2-user:ec2-user /home/ec2-user

systemctl daemon-reload
systemctl enable --now caddy
systemctl enable fuelsense fuelsense-db-backup.timer
systemctl start fuelsense-db-backup.timer
touch /home/ec2-user/.bootstrapped
